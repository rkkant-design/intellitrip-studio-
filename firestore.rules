rules_version = '2';

// IntelliTrip sync: each signed-in person can read and write only their own
// data under users/{their uid}/. Nobody else, signed in or not, can see it.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
