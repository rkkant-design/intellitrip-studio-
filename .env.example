# Copy to .env (git-ignored) for local dev, and set the same values in the
# Netlify dashboard under Site settings → Environment variables for production.

# Required: your OpenAI API key (server-side only, never exposed to the browser).
# Netlify scope: Functions.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: the model and how hard it thinks. gpt-5.6-sol (the default) follows the planning rules best;
# gpt-5.6-terra is cheaper. gpt-5 and gpt-5-mini stop working on 11 Dec 2026.
# low effort keeps a plan to a few minutes.
# OPENAI_MODEL=gpt-5.6-sol
# Packing lists use a cheaper model:
# OPENAI_MODEL_LIGHT=gpt-5.6-terra
# REASONING_EFFORT=low

# Optional: web search for routes, food stops, weather and official rules.
# WEB_SEARCH=true
# MAX_SEARCHES=15

# Interim abuse protection on /api/plan and /api/pack (until real auth lands).
# Max plans or packing lists started per client per minute (best-effort, per warm instance).
# RATE_LIMIT_PER_MIN=10
# Extra host names allowed to call the endpoints (comma-separated), on top of
# the site's own host + localhost. Usually leave empty.
# ALLOWED_ORIGINS=

# Live traffic map. Public Mapbox token, exposed to the browser at build time —
# restrict it by URL in your Mapbox account settings. Without it, the map shows
# a "not configured" placeholder and the rest of the app works normally.
# VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# --- Firebase Google auth (client config — public, safe in the browser) ---
# Set these (Netlify scope: Builds) to switch on Google sign-in. When absent,
# the app falls back to the simple name-only login.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Server-side (Netlify scope: Functions). Set this to the SAME project id to
# REQUIRE a valid Firebase login on the AI endpoints. When absent, they stay in
# interim mode (origin + rate-limit only).
# FIREBASE_PROJECT_ID=your-project-id
